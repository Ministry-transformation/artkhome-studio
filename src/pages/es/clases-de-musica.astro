---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { sitePath } from '../../data/site';
import { disciplines } from '../../data/site';
---
<SiteLayout title="Clases de música" description="Disciplinas musicales de ArtKHome Studio en Torrevieja. Consulta disponibilidad y horarios." active="/es/clases-de-musica/" alternateHref={sitePath('/uk/muzyka/')}>
  <section class="page-hero wrap"><p class="eyebrow">01 / Música · Torrevieja</p><h1>Encuentra tu<br /><em>forma de sonar.</em></h1><p class="page-lead">La tarjeta de ArtKHome Studio presenta clases de canto, piano, guitarra, violín, solfeo y coro, además de desarrollo musical desde los 3 años.</p><a class="button button-yellow" href={sitePath('/es/contacto/')}>Consultar opciones y horarios <span aria-hidden="true">↗</span></a><img class="page-art page-art-image" src={sitePath('/images/artwork/music-object.webp')} alt="" aria-hidden="true" loading="lazy" decoding="async" /></section>
  <section class="content-section wrap"><div class="section-heading"><p class="eyebrow">Disciplinas indicadas por el centro</p><h2>Música para <em>explorar.</em></h2></div><div class="discipline-cards">{disciplines.map((item, i) => <article class="discipline-card"><span>0{i+1}</span><h3>{item}</h3><p>Pregunta al centro por el formato, los horarios y la disponibilidad actuales.</p></article>)}</div><article class="age-card"><span class="age-number">3+</span><div><p class="eyebrow">Desarrollo musical</p><h3>Un espacio para empezar a descubrir la música.</h3><p>El desarrollo musical 3+ figura entre las actividades anunciadas en la tarjeta. Consulta directamente el enfoque y las plazas actuales.</p></div></article></section>
  <section class="closing-cta"><div class="wrap closing-inner"><p class="eyebrow">Siguiente paso</p><h2>Cuéntanos qué<br /><em>te gustaría aprender.</em></h2><a class="button button-yellow" href={sitePath('/es/contacto/')}>Consultar por teléfono <span aria-hidden="true">↗</span></a></div></section>
</SiteLayout>
